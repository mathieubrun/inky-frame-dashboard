{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: cli",
      "type": "debugpy",
      "request": "launch",
      "module": "typer",
      "args": [
        "src/cli/main.py",
        "run",
        "version",
      ],
    },
    {
      "name": "Python: api",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "src.api.main:app",
        "--reload",
        "--log-config",
        "src/api/logger_config.yaml",
      ],
    },
  ]
}